model Notification {
  id        String   @id @default(uuid())
  message   String

  createdById String
  createdBy   User    @relation("NotificationsCreatedBy", fields: [createdById],references: [id])

  sendToId String?
  sendTo   User?   @relation( "NotificationsSendTo", fields: [sendToId], references: [id] )

  status    NotificationStatus @default(EVERYONE)
  createdAt DateTime @default(now())

  reads NotificationRead[]
}

model NotificationRead {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
  @@map("NotificationReads")
}
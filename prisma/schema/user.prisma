model User {
  id                     String                 @id @default(uuid())
  username               String                 @unique
  password               String
  email                  String                 @unique
  status                 UserStatus             @default(ACTIVE)
  role                   UserRole
  isDeleted              Boolean                @default(false)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  profileId              String?                @unique
  fullName               String                 @default("")
  isVerified             Boolean                @default(false)
  verifyCode             String?
  verifyCodeExpiry       DateTime?
  resetPasswordToken     String?
  resetPasswordExpiry    DateTime?
  blogs                  Blog[]
  donationsGiven         BloodDonationHistory[] @relation("Donor")
  donationsReceived      BloodDonationHistory[] @relation("Recipient")
  bloodRequests          BloodRequest[]         @relation("Requester")
  events                 Event[]
  notificationsCreatedBy Notification[]         @relation("NotificationsCreatedBy")
  notificationsSendTo    Notification[]         @relation("NotificationsSendTo")
  profile                UserProfile?           @relation(fields: [profileId], references: [id])
  notificationReads      NotificationRead[]
  
  @@map("Users")
}

model UserProfile {
  id               String     @id @default(uuid())
  img              String?
  bloodGroup       BloodGroup
  phoneNumber      String
  guardianNumber   String?
  numberOfDonation Int        @default(0)
  district         String
  town             String
  address          String?
  dateOfBirth      DateTime
  gender           String
  state            String
  user             User?

  @@map("UserProfiles")
}

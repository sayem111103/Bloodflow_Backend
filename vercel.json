
{
  "version": 2,
  "builds": [
    { 
      "src": "src/server.ts",
      "use": "@vercel/node" 
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/src/server.ts" 
    }
  ],
  "crons": [
    { 
      "path": "/api/v1/notification/cleanup",
      "schedule": "0 0 * * *" 
    }
  ]
}